{
  "name": "freewin",
  "main": "en/worker/index.js",

  "compatibility_date": "2024-04-01",

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "assets": {
    "binding": "ASSETS",
    "directory": "./en",
    "run_worker_first": true
  },

  // ============================================================
  // FREEWIN - DEFAULT / NORMAL DEPLOYMENT
  // ============================================================

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freewin-db",
      "database_id": "8aa163e4-7dc1-4539-b505-b1b43b021e30"
    }
  ],

  "ai": {
    "binding": "AI"
  },

  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "2fcbbbf788d4419dba6c2e5e4ae3e764"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "freewin-media"
    }
  ],

//  "triggers": {
  //  "crons": [
    //  "0 */6 * * *"
   // ]
 // },

  // ============================================================
  // ADDITIONAL WORKER ENVIRONMENTS
  // ============================================================

  "env": {

    
    // ==========================================================
    // LUMMET
    // ==========================================================

    "lummet": {
      "name": "lummet",

      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lummet-db",
          "database_id": "05f29e32-2be5-443f-afe1-ec4d9cc0bdc5"
        }
      ],

      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "feb4a5dd9f74428ba83ceb91556f34a1"
        }
      ],

      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "lummet-media"
        }
      ]
    },

    // ==========================================================
    // LEVELCASINO
    // ==========================================================

    "levelcasino": {
      "name": "levelcasino",

      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "levelcasino-db",
          "database_id": "8e68c1f7-e284-415c-a67c-6ba0c5d0a1f8"
        }
      ],

      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "0557421566ac40a999c365bb6936a53f"
        }
