{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "lummet-tenant",
  "main": "en/worker/index.js",

  "compatibility_date": "2026-01-01",

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "keep_vars": true,

  "assets": {
    "binding": "ASSETS",
    "directory": "./en",
    // Every route goes through the Worker EXCEPT /static/* (CSS, JS, images), which Cloudflare
    // serves straight from the edge without waking the Worker (faster, and a page view no longer
    // costs 25+ Worker requests). Cache headers for those files are in en/_headers.
    "run_worker_first": ["/*", "!/static/*"]
  },


  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lummet-tenant-db",
      "database_id": "4356b8a1-90f4-495c-ae6e-cbc8c30448d2"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "d6b712aa06da49828e55a20f13ca106b"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "lummet-tenant-media"
    }
  ],

  "ai": {
    "binding": "AI"
  }
}
