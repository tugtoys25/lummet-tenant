{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "lummet-tenant",
  "main": "en/worker/index.js",

  "compatibility_date": "2026-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  "keep_vars": true,

  "assets": {
    "binding": "ASSETS",
    "directory": "./en",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "TENANT_DB",
      "database_id": "TENANT_DB_ID"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "TENANT_CACHE_ID"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "lummet-tenant-media"
    }
  ],

  "ai": {
    "binding": "AI"
  }
}
