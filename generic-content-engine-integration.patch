@@ -0,0 +1,70 @@
+<div class="admin-wrapper">
+  {{admin_nav}}
+
+  <div class="admin-content">
+    <div class="admin-header">
+      <h1>Add Content Item</h1>
+      <a href="/en/dashboard/content-items" class="btn btn--ghost">Back to List</a>
+    </div>
+
+    <div id="contentItemFormAlert" class="alert" style="display:none"></div>
+
+    <form id="contentItemForm" class="admin-form">
+      <label>Content Type
+        <select name="content_type" id="contentTypeSelect" required>
+          <option value="sportsbook">Sportsbook</option>
+          <option value="affiliate_partner">Affiliate Partner</option>
+          <option value="custom">Custom</option>
+        </select>
+      </label>
+
+      <div id="customTypeField" style="display:none">
+        <label>Custom Type
+          <select name="custom_type_slug" id="customTypeSelect"></select>
+        </label>
+      </div>
+
+      <label>Name <input type="text" name="name" required></label>
+      <label>Slug <input type="text" name="slug" required pattern="[a-z0-9-]+" title="lowercase letters, numbers, hyphens only"></label>
