+      <label>Description <textarea name="description" rows="4"></textarea></label>
+      <label>Website URL <input type="url" name="website"></label>
+      <label>Rating (0-5) <input type="number" name="rating" min="0" max="5" step="0.1"></label>
+
+      <div id="sportsbookFields" style="display:none">
+        <label>License <input type="text" name="license"></label>
+        <label>License Country <input type="text" name="license_country"></label>
+        <label><input type="checkbox" name="live_betting"> Live Betting</label>
+        <label><input type="checkbox" name="pre_match"> Pre-Match</label>
+        <label><input type="checkbox" name="cashout"> Cashout</label>
+        <label><input type="checkbox" name="mobile_app"> Mobile App</label>
+      </div>
+
+      <div id="affiliatePartnerFields" style="display:none">
+        <label>Linked Commercial Affiliate Partner ID (optional)
+          <input type="number" name="linked_affiliate_partner_id">
+        </label>
+        <p class="muted">Leave blank for editorial-only coverage with no commercial relationship.</p>
+      </div>
+
+      <label>Featured <input type="checkbox" name="featured"></label>
+      <label>Sort Order <input type="number" name="sort_order" value="0"></label>
+      <label>Status
+        <select name="status">
+          <option value="draft">Draft</option>
+          <option value="published">Published</option>
+        </select>
+      </label>
+      <label>Published <input type="checkbox" name="published"></label>
+
+      <fieldset>
+        <legend>SEO</legend>
+        <label>SEO Title <input type="text" name="seo_title"></label>
+        <label>SEO Description <textarea name="seo_description" rows="2"></textarea></label>
+        <label>SEO Keywords <input type="text" name="seo_keywords"></label>
