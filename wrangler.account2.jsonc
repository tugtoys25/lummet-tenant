{
  "name": "freewin",
  "main": "en/worker/index.js",

  "compatibility_date": "2024-04-01",

  // Keep plaintext variables set in the Cloudflare dashboard
  // (e.g. TURNSTILE_SITEKEY) instead of removing them on deploy.
  "keep_vars": true,

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "assets": {
    "binding": "ASSETS",
    "directory": "./en",
    "run_worker_first": true
  },

  // ============================================================
  // FREEWIN - DEFAULT / NORMAL DEPLOYMENT
  // ============================================================

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freewin-db",
      "database_id": "480e05dc-5131-42c7-9de5-43aa2afad975"
    }
  ],

  "ai": {
    "binding": "AI"
  },

  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "89b1ab80acb24a9bb65edc610892a6cf"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "freewin-media"
    }
  ],

  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  },

  // ============================================================
  // ADDITIONAL WORKER ENVIRONMENTS
  // ============================================================

  "env": {

    
    // ==========================================================
    // LUMMET
    // ==========================================================

    "lummet": {
      "name": "lummet",

      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lummet-db",
          "database_id": "ebe8f008-54af-431e-99ad-5370d63a3645"
        }
      ],

      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "8f8ace9a016a46f4b3f1634837c7d81f"
        }
      ],

      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "lummet-media"
        }
      ],

      "ai": {
        "binding": "AI"
      }
    },

    // ==========================================================
    // CLUSTERCASINO
    // ==========================================================

    "clustercasino": {
      "name": "clustercasino",

      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "clustercasino-db",
          "database_id": "b79e4be1-3858-4877-a022-ded1be615993"
        }
      ],

      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "28c478252d794c87aa2610efb0192c9c"
        }
      ],

      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "cluster-casino-media"
        }
      ],

      "ai": {
        "binding": "AI"
      }
    },

    // ==========================================================
    // NEUROODDS
    // ==========================================================

    "neuroodds": {
      "name": "neuroodds",

      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "neuroodds-db",
          "database_id": "33fc5cfa-1390-4c81-a9c3-687214a2c7b8"
        }
      ],

      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "fdbe55ac355948cbbd894120c96f57de"
        }
      ],

      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "neuroodds-media"
        }
      ],

      "ai": {
        "binding": "AI"
      }
    },

    // ==========================================================
    // LEGENDODDS
    // ==========================================================

    "legendodds": {
      "name": "legendodds",

      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "legendodds-db",
          "database_id": "a8ceb263-c1c8-40db-bd5f-7cfe19e0c2ba"
        }
      ],

      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "ce984b229d3c4278b32db71a1fa0484a"
        }
      ],

      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "legendodds-media"
        }
      ],

      "ai": {
        "binding": "AI"
      }
    },

    // ==========================================================
    // BLUCCA
    // ==========================================================

    "blucca": {
      "name": "blucca",

      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "blucca-db",
          "database_id": "32bc65bf-20e7-41a4-9f24-32c7dfed021c"
        }
      ],

      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "e49336c4d27e430bbaec42bf91f3f20c"
        }
      ],

      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "blucca-media"
        }
      ],

      "ai": {
        "binding": "AI"
      }
    },

    // ==========================================================
    // BRILLIANTODDS
    // ==========================================================

    "brilliantodds": {
      "name": "brilliantodds",

      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "brilliantodds-db",
          "database_id": "95195cb4-0e1c-4442-b9d0-f19ef8288602"
        }
      ],

      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "d431bfaab9864f54ac87c99a8b0d91a4"
        }
      ],

      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "brilliantodds-media"
        }
      ],

      "ai": {
        "binding": "AI"
      }
    }
  }
}
